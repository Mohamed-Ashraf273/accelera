        "required": false,
        "allowed_values": [
          "dark",
          "light"
        ]
      },
      {
        "name": "proline_class",
        "type": "string",
        "required": false,
        "allowed_values": [
          "high",
          "low",
          "medium"
        ]
      }
    ]
  },
  "tracking": {
    "enabled": true,
