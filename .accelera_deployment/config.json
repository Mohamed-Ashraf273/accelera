        "type": "number",
        "required": false,
        "min": 0.34,
        "max": 5.08
      },
      {
        "name": "color_intensity",
        "type": "number",
        "required": false,
        "min": 1.28,
        "max": 13.0
      },
      {
        "name": "hue",
        "type": "number",
        "required": false,
        "min": 0.48,
        "max": 1.71
